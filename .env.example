# Copie para .env.local (ignorado pelo Git) para ligar o front à API Condo+.
# Sem VITE_API_URL, o app usa apenas os dados mock locais.
VITE_API_URL=http://localhost:8080

# Somente desenvolvimento, enquanto o login real não está integrado:
# token JWT obtido em POST /auth/login (Swagger: http://localhost:8080/swagger-ui.html).
# Expira em 8 horas. Nunca versione um token real.
VITE_API_TOKEN=
